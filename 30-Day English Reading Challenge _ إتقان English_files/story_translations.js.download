// Helper function to get translation for a specific sentence index in a day
function getStorySentenceTranslation(day, sentenceIdx, rawSentence, dictionary) {
  if (storySentenceTranslations[day] && storySentenceTranslations[day][sentenceIdx]) {
    return storySentenceTranslations[day][sentenceIdx];
  }

  // Smart fallback using words from the dictionary
  if (dictionary && rawSentence) {
    const words = rawSentence.toLowerCase().match(/\b[\w'-]+\b/g) || [];
    const translated = words
      .map(w => dictionary[w] || dictionary[w.replace(/'s$/, '')] || null)
      .filter(Boolean);
    if (translated.length > 0) {
      return `مفردات السطر: ${translated.slice(0, 5).join(' • ')}`;
    }
  }
  return 'المس أي كلمة للتعرف على ترجمتها ونطقها';
}
